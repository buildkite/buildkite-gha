#!/usr/bin/env bash
set -euo pipefail

root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$root"
trap 'rm -rf dist' EXIT

goreleaser release --snapshot --clean --skip=publish

expected="$(printf '%s\n' \
  buildkite-gha_darwin_arm64 \
  buildkite-gha_linux_arm64 \
  buildkite-gha_linux_x86_64 \
  buildkite-gha_windows_x86_64.exe \
  checksums.txt | sort)"
# Exclude only local metadata and un-packaged build outputs, not release assets.
actual="$(jq -r '.[] | select(.type != "Metadata" and (.type != "Binary" or .extra.Format != null)) | .name' dist/artifacts.json | sort)"
[[ "$actual" == "$expected" ]] || {
  printf 'unexpected release assets:\n%s\n' "$actual" >&2
  exit 1
}

# Raw assets keep their build paths locally; their release names appear in
# the manifest and checksums. Materialize those names for checksum verification.
while read -r name goos goarch build_id; do
  path="$(jq -er --arg name "$name" --arg goos "$goos" --arg goarch "$goarch" '
    [.[] | select(.type == "Binary" and .extra.Format == "binary" and
      .name == $name and .goos == $goos and .goarch == $goarch)] |
    if length == 1 then .[0].path else error("expected one raw asset for " + $name) end
  ' dist/artifacts.json)"
  build_path="$(jq -er --arg id "$build_id" '
    [.[] | select(.type == "Binary" and .extra.Format == null and .extra.ID == $id)] |
    if length == 1 then .[0].path else error("expected one build output for " + $id) end
  ' dist/artifacts.json)"
  cp "$path" "dist/$name"
  cmp "$build_path" "dist/$name"
  metadata="$(go version -m "dist/$name")"
  printf '%s\n' "$metadata" | grep -Fx $'\tbuild\tGOOS='"$goos" >/dev/null
  printf '%s\n' "$metadata" | grep -Fx $'\tbuild\tGOARCH='"$goarch" >/dev/null
done <<'TARGETS'
buildkite-gha_linux_x86_64 linux amd64 buildkite-gha-linux
buildkite-gha_linux_arm64 linux arm64 buildkite-gha-linux-arm64
buildkite-gha_darwin_arm64 darwin arm64 buildkite-gha-darwin
buildkite-gha_windows_x86_64.exe windows amd64 buildkite-gha-windows
TARGETS

[[ "$(awk '{print $2}' dist/checksums.txt | sort)" == "$(printf '%s\n' "$expected" | grep -v '^checksums.txt$')" ]] || {
  printf '%s\n' 'checksums.txt must cover only the four raw executables, exactly once each' >&2
  exit 1
}
if command -v sha256sum >/dev/null; then
  (cd dist && sha256sum --check checksums.txt)
else
  (cd dist && shasum -a 256 --check checksums.txt)
fi

printf '%s\n' 'release artifact tests passed'
