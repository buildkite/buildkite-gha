#!/usr/bin/env bash
set -euo pipefail

usage() {
  echo 'usage: scripts/oss-corpus [--profile] [case ...]' >&2
}

profile=false
case_ids=()
while (( $# > 0 )); do
  case "$1" in
    --profile) profile=true ;;
    --help|-h) usage; exit 0 ;;
    -*) usage; exit 2 ;;
    *) case_ids+=("$1") ;;
  esac
  shift
done
if $profile && (( ${#case_ids[@]} == 0 )); then
  echo '--profile requires explicit case names to bound anonymous GitHub API use' >&2
  exit 2
fi

root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
readonly root manifest="$root/testdata/oss/manifest.json"
work="$(mktemp -d "${TMPDIR:-/tmp}/buildkite-gha-oss-corpus.XXXXXXXX")"
trap 'rm -rf -- "$work"' EXIT

cd "$root"
jq -e '
  .schema == "buildkite-gha/oss-corpus/v2" and
  (.cases | type == "array" and length > 0) and
  all(.cases[];
    (.id | test("^[a-z0-9]+(?:-[a-z0-9]+)*$")) and
    (.repository | test("^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$")) and
    (.commit | test("^[0-9a-f]{40}$")) and
    (.workflow | test("^\\.github/workflows/[A-Za-z0-9_.-]+\\.ya?ml$")) and
    (.workflow_sha256 | test("^[0-9a-f]{64}$")) and
    (.default_branch | test("^[A-Za-z0-9][A-Za-z0-9._/-]*$") and (contains("..") | not)) and
    (.event | IN("push", "pull_request")) and
    ((.github_run == null) or (.github_run | test("^https://github.com/[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+/actions/runs/[1-9][0-9]*$"))) and
    (.expected.compile | IN("compilable", "incompatible")) and
    (.expected.profile | IN("admitted", "not-admitted", "indeterminate", "not-run")) and
    ((.expected.logical_jobs == null) or (.expected.logical_jobs | type == "number" and . > 0)) and
    ((.expected.instances == null) or (.expected.instances | type == "number" and . > 0)) and
    ((.expected.diagnostic_code == null) or (.expected.diagnostic_code | test("^E_[A-Z0-9_]+$"))) and
    (if .expected.compile == "incompatible" then
       .expected.profile == "not-run" and .expected.diagnostic_code == "E_COMPILE"
     else
       .expected.logical_jobs != null and .expected.instances != null and
       (if .expected.profile == "admitted" then .expected.diagnostic_code == null else .expected.diagnostic_code != null end)
     end)) and
  ([.cases[].id] | length == (unique | length))
' "$manifest" >/dev/null

if (( ${#case_ids[@]} == 0 )); then
  mapfile -t case_ids < <(jq -r '.cases[].id' "$manifest")
fi
for id in "${case_ids[@]}"; do
  jq -e --arg id "$id" 'any(.cases[]; .id == $id)' "$manifest" >/dev/null || {
    echo "unknown corpus case: $id" >&2
    exit 2
  }
done

CGO_ENABLED=0 mise exec -- go build -trimpath -buildvcs=false -o "$work/buildkite-gha" ./cmd/buildkite-gha

clean_env() {
  env \
    -u HTTP_PROXY -u HTTPS_PROXY -u ALL_PROXY -u NO_PROXY \
    -u http_proxy -u https_proxy -u all_proxy -u no_proxy \
    -u CURL_CA_BUNDLE -u SSL_CERT_FILE -u SSL_CERT_DIR \
    -u GH_TOKEN -u GITHUB_TOKEN -u BUILDKITE_GHA_GITHUB_TOKEN \
    "$@"
}

make_event() {
  local repository=$1 commit=$2 branch=$3 event=$4 destination=$5
  local owner=${repository%%/*} name=${repository#*/}
  jq -n \
    --arg owner "$owner" --arg name "$name" --arg sha "$commit" \
    --arg branch "$branch" --arg event "$event" '
    def clone_url: "https://github.com/" + $owner + "/" + $name + ".git";
    def payload_repo: {
      clone_url: clone_url,
      full_name: ($owner + "/" + $name)
    };
    def repository: {
      owner: $owner,
      name: $name,
      clone_url: clone_url,
      default_branch: $branch
    };
    {
      provider: "github",
      event: $event,
      repository: repository,
      ref: (if $event == "pull_request" then "refs/pull/1/head" else "refs/heads/" + $branch end),
      sha: $sha,
      actor: "buildkite-gha-corpus",
      payload: (if $event == "pull_request" then {
        number: 1,
        pull_request: {
          number: 1,
          head: {sha: $sha, ref: "corpus", repo: payload_repo},
          base: {ref: $branch, repo: payload_repo}
        }
      } else {ref: ("refs/heads/" + $branch)} end)
    }
  ' > "$destination"
}

run_report() {
  local case_root=$1 label=$2 expected=$3 jobs=$4 instances=$5 diagnostic=$6 output=$7
  shift 7
  local status=0 expected_status=1
  (cd "$case_root" && clean_env "$@") > "$output" || status=$?
  [[ "$expected" == compilable || "$expected" == admitted ]] && expected_status=0
  [[ "$status" == "$expected_status" ]] || {
    echo "$label: exit=$status, want $expected_status" >&2
    return 1
  }
  jq -e \
    --arg result "$expected" --arg diagnostic "$diagnostic" \
    --argjson jobs "$jobs" --argjson instances "$instances" '
    def graph: if has("compile") then .compile else . end;
    .result == $result and
    (if $jobs == 0 then true else graph.logical_jobs == $jobs and graph.instances == $instances end) and
    (if $diagnostic == "" then true else any(.diagnostics[]?; .code == $diagnostic) end)
  ' "$output" >/dev/null || {
    echo "$label: report did not match result=$expected diagnostic=${diagnostic:-none}" >&2
    jq '{result, compile, admission, diagnostics}' "$output" >&2
    return 1
  }
  echo "$label: result=$expected logical_jobs=${jobs:-0} instances=${instances:-0} diagnostic=${diagnostic:-none}"
}

for id in "${case_ids[@]}"; do
  entry="$(jq -c --arg id "$id" '.cases[] | select(.id == $id)' "$manifest")"
  repository="$(jq -r '.repository' <<<"$entry")"
  commit="$(jq -r '.commit' <<<"$entry")"
  workflow="$(jq -r '.workflow' <<<"$entry")"
  workflow_sha256="$(jq -r '.workflow_sha256' <<<"$entry")"
  branch="$(jq -r '.default_branch' <<<"$entry")"
  event="$(jq -r '.event' <<<"$entry")"
  expected_compile="$(jq -r '.expected.compile' <<<"$entry")"
  expected_profile="$(jq -r '.expected.profile' <<<"$entry")"
  expected_jobs="$(jq -r '.expected.logical_jobs // 0' <<<"$entry")"
  expected_instances="$(jq -r '.expected.instances // 0' <<<"$entry")"
  expected_diagnostic="$(jq -r '.expected.diagnostic_code // ""' <<<"$entry")"
  compile_diagnostic=
  if [[ "$expected_compile" == incompatible ]]; then
    compile_diagnostic=$expected_diagnostic
  fi

  case_root="$work/cases/$id"
  workflow_path="$case_root/$workflow"
  event_path="$work/$id.event.json"
  mkdir -p "$(dirname "$workflow_path")"
  clean_env curl -q --fail --silent --show-error --proto '=https' --tlsv1.2 \
    --max-time 30 --max-filesize 1048576 --output "$workflow_path" \
    "https://raw.githubusercontent.com/$repository/$commit/$workflow"
  actual_sha256="$(sha256sum "$workflow_path" | cut -d' ' -f1)"
  [[ "$actual_sha256" == "$workflow_sha256" ]] || {
    echo "$id: workflow digest=$actual_sha256, want $workflow_sha256" >&2
    exit 1
  }
  make_event "$repository" "$commit" "$branch" "$event" "$event_path"

  if $profile && [[ "$expected_profile" != not-run ]]; then
    run_report "$case_root" "$id/profile" "$expected_profile" "$expected_jobs" \
      "$expected_instances" "$expected_diagnostic" "$work/$id.profile.json" \
      "$work/buildkite-gha" validate --profile hosted-tokenless --format json \
      --event-path "$event_path" "$workflow"
  else
    run_report "$case_root" "$id/compile" "$expected_compile" "$expected_jobs" \
      "$expected_instances" "$compile_diagnostic" "$work/$id.compile.json" \
      "$work/buildkite-gha" validate --format json --event-path "$event_path" "$workflow"
  fi
done

echo "PASS: ${#case_ids[@]} open-source workflow case(s) matched their expected classifications."
if $profile; then
  echo 'CAVEAT: profile checks resolve actions but do not execute third-party code.'
fi
