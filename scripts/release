#!/usr/bin/env bash
set -euo pipefail

die() { printf '[release] error: %s\n' "$*" >&2; exit 1; }
for command in amp git; do command -v "$command" >/dev/null 2>&1 || die "missing required command: $command"; done

root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$root"
[[ "$(git branch --show-current)" == main ]] || die 'releases must be made from main'
[[ -z "$(git status --porcelain --untracked-files=all)" ]] || die 'working tree is not clean'
git fetch origin main --tags
[[ "$(git rev-parse HEAD)" == "$(git rev-parse origin/main)" ]] || die 'main is not up to date with origin/main'

if [[ -z "$(git tag --list 'v*')" ]]; then
  current='no release'
  next=v0.1.0
else
  current=''
  while IFS= read -r tag; do
    if [[ "$tag" =~ ^v0\.(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)$ ]]; then
      current="$tag"
      break
    fi
  done < <(git tag --merged HEAD --list 'v0.*' --sort=-version:refname)
  [[ -n "$current" ]] || die 'no pre-1.0 release tag is reachable from main'

  assessment="$({
    printf 'COMMITS %s..HEAD\n' "$current"
    git log --format='%H %s' "$current..HEAD"
    printf '\nDIFF STAT %s..HEAD\n' "$current"
    git diff --stat "$current..HEAD"
    printf '\nDIFF %s..HEAD\n' "$current"
    git diff --no-ext-diff "$current..HEAD"
  } | scripts/select-release-version "$current")" || die 'release agent did not produce a usable version decision'

  mapfile -t assessment_lines <<< "$assessment"
  [[ ${#assessment_lines[@]} -eq 3 ]] || die 'release agent result has an invalid format'
  [[ "${assessment_lines[0]}" =~ ^VERSION=(v0\.(0|[1-9][0-9]*)\.(0|[1-9][0-9]*))$ ]] \
    || die 'release agent result has an invalid version'
  next="${BASH_REMATCH[1]}"
  [[ "${assessment_lines[1]}" =~ ^DECISION=(patch|minor)$ ]] \
    || die 'release agent result has an invalid decision'
  decision="${BASH_REMATCH[1]}"
  [[ "${assessment_lines[2]}" =~ ^RATIONALE=(.+)$ ]] \
    || die 'release agent result has no rationale'
  rationale="${BASH_REMATCH[1]}"
  printf 'Agent decision: %s\nRationale: %s\n' "$decision" "$rationale"
fi
[[ "$next" =~ ^v0\.[0-9]+\.[0-9]+$ ]] || die "refusing non-v0 release: $next"
[[ "$next" != "$current" ]] || die "no version bump detected (current: $current)"

printf 'Releasing %s -> %s\n' "$current" "$next"
read -r -p "Type ${next} to create and push this tag: " confirmation \
  || die 'release canceled before tagging'
[[ "$confirmation" == "$next" ]] || die 'release canceled before tagging'
git tag "$next"
git push origin "$next"
printf 'Tagged and pushed %s; Buildkite will publish it.\n' "$next"
