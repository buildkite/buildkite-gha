#!/usr/bin/env bash
set -euo pipefail

if [[ $# != 0 ]]; then
  echo 'usage: mise run release (Buildkite chooses the version)' >&2
  exit 1
fi

case "${RELEASE_DRY_RUN:-0}" in
  0|1) ;;
  *) echo 'RELEASE_DRY_RUN must be 0 or 1' >&2; exit 1 ;;
esac

: "${RELEASE_PIPELINE:?Set RELEASE_PIPELINE to the configured organization/pipeline}"
commit="$(git ls-remote --exit-code https://github.com/buildkite/buildkite-gha refs/heads/main | cut -f1)"
[[ "$commit" =~ ^[0-9a-f]{40}$ ]]
exec bk build create --pipeline "$RELEASE_PIPELINE" \
  --branch main --commit "$commit" --message 'Release buildkite-gha' \
  --env "RELEASE_DRY_RUN=${RELEASE_DRY_RUN:-0}" --yes
