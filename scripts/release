#!/usr/bin/env bash
set -euo pipefail

die() { printf '[release] error: %s\n' "$*" >&2; exit 1; }
for command in bk git svu; do command -v "$command" >/dev/null 2>&1 || die "missing required command: $command"; done

root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$root"
[[ "$(git branch --show-current)" == main ]] || die 'releases must be made from main'
[[ -z "$(git status --porcelain --untracked-files=all)" ]] || die 'working tree is not clean'
git fetch origin main --tags
[[ "$(git rev-parse HEAD)" == "$(git rev-parse origin/main)" ]] || die 'main is not up to date with origin/main'

current="$(svu current)"
if [[ -z "$(git tag --list 'v*')" ]]; then
  next=v0.1.0
else
  next="$(svu next)"
fi
if [[ "$current" == v0.* && "$next" == v1.* ]]; then next="$(svu minor)"; fi
[[ "$next" =~ ^v0\.[0-9]+\.[0-9]+$ ]] || die "refusing non-v0 release: $next"
[[ "$next" != "$current" ]] || die "no version bump detected (current: $current)"

printf 'Requesting release %s -> %s\n' "$current" "$next"
bk build create \
  --yes \
  --pipeline buildkite/buildkite-gha \
  --branch main \
  --commit "$(git rev-parse HEAD)" \
  --message "Release $next" \
  --env "RELEASE_VERSION=$next"
