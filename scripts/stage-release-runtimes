#!/usr/bin/env bash
set -euo pipefail

# Keep these pins in sync with mise.toml.
readonly node20_version=20.20.2
readonly node24_version=24.18.0
readonly node_dist_url=https://nodejs.org/dist

die() { printf '[stage-release-runtimes] error: %s\n' "$*" >&2; exit 1; }
require_command() { command -v "$1" >/dev/null 2>&1 || die "missing required command: $1"; }

for command in curl sha256sum tar mktemp; do require_command "$command"; done
[[ "$(uname -s)" == Linux && "$(uname -m)" == x86_64 ]] || die 'native validation requires Linux x86-64'

root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
release_root="${RELEASE_ROOT:-${root}/.release}"
mkdir -p "$release_root"
work="$(mktemp -d "${release_root}/.runtimes.XXXXXXXX")"
cleanup() { rm -rf -- "$work"; }
trap cleanup EXIT INT TERM

stage_runtime() {
  local major="$1" version="$2"
  local archive="node-v${version}-linux-x64.tar.xz"
  local url="${node_dist_url}/v${version}"
  local archive_path="${work}/${archive}" sums="${work}/SHASUMS256-${version}.txt"
  local expected

  curl --fail --silent --show-error --location --proto '=https' --tlsv1.2 \
    --output "$archive_path" "${url}/${archive}"
  curl --fail --silent --show-error --location --proto '=https' --tlsv1.2 \
    --output "$sums" "${url}/SHASUMS256.txt"
  expected="$(awk -v name="$archive" '$2 == name { print $1 }' "$sums")"
  [[ "$expected" =~ ^[0-9a-f]{64}$ ]] || die "missing unique checksum for ${archive}"
  [[ "$(awk -v name="$archive" '$2 == name { count++ } END { print count+0 }' "$sums")" == 1 ]] || die "duplicate checksum for ${archive}"
  printf '%s  %s\n' "$expected" "$archive_path" | sha256sum --check --status - \
    || die "checksum mismatch for ${archive}"

  mkdir -p "${work}/runtimes/node${major}/bin"
  tar -xJf "$archive_path" --strip-components=1 \
    -C "${work}/runtimes/node${major}" \
    "node-v${version}-linux-x64/bin/node" \
    "node-v${version}-linux-x64/LICENSE"
  [[ "$("${work}/runtimes/node${major}/bin/node" --version)" == "v${version}" ]] \
    || die "node${major} executable has the wrong version"
}

stage_runtime 20 "$node20_version"
stage_runtime 24 "$node24_version"

# Rename within release_root so publication does not expose a partial tree.
old="${release_root}/.runtimes.old.$$"
if [[ -e "${release_root}/runtimes" ]]; then mv -- "${release_root}/runtimes" "$old"; fi
if ! mv -- "${work}/runtimes" "${release_root}/runtimes"; then
  [[ ! -e "$old" ]] || mv -- "$old" "${release_root}/runtimes"
  die 'failed to publish staged runtimes'
fi
rm -rf -- "$old"
echo "Staged Node ${node20_version} and ${node24_version} in ${release_root}/runtimes"
