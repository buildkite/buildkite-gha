#!/usr/bin/env bash
set -euo pipefail

if (( $# != 2 )) || [[ ! $1 =~ ^[1-9][0-9]*$ ]] || [[ ! $2 =~ ^[0-9a-f]{40}$ ]]; then
  echo 'usage: scripts/verify-upload-artifact <build-number> <commit>' >&2
  exit 2
fi

readonly build_number=$1
readonly expected_commit=$2
readonly pipeline=${UPLOAD_ARTIFACT_PIPELINE_SLUG:-buildkite-gha}
readonly step_key=gha-upload-artifact

command -v bk >/dev/null
command -v jq >/dev/null
command -v unzip >/dev/null
if ! command -v sha256sum >/dev/null && ! command -v shasum >/dev/null; then
  echo 'sha256sum or shasum is required' >&2
  exit 1
fi

sha256_digest() {
  if command -v sha256sum >/dev/null; then
    sha256sum "$@" | cut -d ' ' -f 1
  else
    shasum -a 256 "$@" | cut -d ' ' -f 1
  fi
}

build="$(bk --no-pager api "/pipelines/$pipeline/builds/$build_number")"
commit="$(jq -r '.commit // ""' <<<"$build")"
if [[ $commit != "$expected_commit" ]]; then
  echo "build $build_number ran commit $commit, expected $expected_commit" >&2
  exit 1
fi
readonly commit
build_id="$(jq -r '.id // ""' <<<"$build")"
readonly build_id

job_ids=()
while IFS= read -r candidate_job_id; do
  job_ids+=("$candidate_job_id")
done < <(jq -r --arg step_key "$step_key" '.jobs[] | select(.step_key == $step_key) | .id' <<<"$build")
if (( ${#job_ids[@]} != 1 )) || [[ ! ${job_ids[0]} =~ ^[0-9a-f]{8}(-[0-9a-f]{4}){3}-[0-9a-f]{12}$ ]]; then
  echo "build $build_number has ${#job_ids[@]} jobs with step key $step_key; expected exactly one" >&2
  exit 1
fi
readonly job_id=${job_ids[0]}
if ! jq -e --arg job_id "$job_id" '.jobs[] | select(.id == $job_id) | .state == "passed"' <<<"$build" >/dev/null; then
  echo "generated upload-artifact job $job_id did not pass" >&2
  exit 1
fi

artifacts="$(bk --no-pager api "/jobs/$job_id/artifacts?per_page=100")"
if ! jq -e --arg job_id "$job_id" '
  length == 2 and
  all(.[]; .job_id == $job_id and .state == "finished") and
  ([.[] | select(.path | test("^buildkite-gha/v1/artifacts/[0-9a-f]{64}\\.zip$"))] | length) == 1 and
  ([.[] | select(.path | test("^buildkite-gha/v1/results/gha-upload-artifact/[0-9a-f]{64}\\.json$"))] | length) == 1
' <<<"$artifacts" >/dev/null; then
  echo "job $job_id does not have exactly one native archive and one terminal manifest" >&2
  exit 1
fi

archive_id="$(jq -r '.[] | select(.path | test("^buildkite-gha/v1/artifacts/")) | .id' <<<"$artifacts")"
readonly archive_id
archive_path="$(jq -r --arg id "$archive_id" '.[] | select(.id == $id) | .path' <<<"$artifacts")"
readonly archive_path
manifest_id="$(jq -r '.[] | select(.path | test("^buildkite-gha/v1/results/")) | .id' <<<"$artifacts")"
readonly manifest_id
manifest_path="$(jq -r --arg id "$manifest_id" '.[] | select(.id == $id) | .path' <<<"$artifacts")"
readonly manifest_path
plan_digest="sha256:${manifest_path##*/}"
plan_digest=${plan_digest%.json}
readonly plan_digest

work="$(mktemp -d "${TMPDIR:-/tmp}/buildkite-gha-upload-artifact-verify.XXXXXXXX")"
trap 'rm -rf -- "$work"' EXIT
(
  cd "$work"
  bk --no-pager artifacts download "$archive_id" --build "$build_number" --job-uuid "$job_id" --pipeline "$pipeline"
  bk --no-pager artifacts download "$manifest_id" --build "$build_number" --job-uuid "$job_id" --pipeline "$pipeline"
)

readonly archive_file="$work/$archive_path"
readonly manifest_file="$work/$manifest_path"
test -f "$archive_file"
test -f "$manifest_file"

artifact_id="$(jq -r '.artifacts[0].id // ""' "$manifest_file")"
readonly artifact_id
artifact_digest="$(jq -r '.artifacts[0].digest // ""' "$manifest_file")"
readonly artifact_digest
readonly digest_hex=${artifact_digest#sha256:}
artifact_size="$(wc -c < "$archive_file" | tr -d ' ')"
readonly artifact_size
if ! jq -e \
  --arg build_id "$build_id" \
  --arg job_id "$job_id" \
  --arg step_key "$step_key" \
  --arg plan_digest "$plan_digest" \
  --arg archive_path "$archive_path" \
  --arg digest "$artifact_digest" \
  --argjson size "$artifact_size" '
    .schema == "buildkite-gha/result-manifest/v2" and
    .plan_digest == $plan_digest and
    .producer == {build_id: $build_id, job_id: $job_id, step_key: $step_key} and
    .result == "success" and .outputs == [] and
    (.artifacts | length) == 1 and
    .artifacts[0].name == "upload-artifact-proof" and
    (.artifacts[0].id | test("^[1-9][0-9]{0,19}$")) and
    .artifacts[0].path == $archive_path and
    .artifacts[0].digest == $digest and
    .artifacts[0].size == $size and
    .artifacts[0].file_count == 2
  ' "$manifest_file" >/dev/null
then
  echo "terminal manifest does not bind the exact upload-artifact contract" >&2
  exit 1
fi

if [[ $(sha256_digest "$archive_file") != "$digest_hex" ]]; then
  echo "native archive digest does not match the terminal manifest" >&2
  exit 1
fi
entries=()
while IFS= read -r entry; do
  entries+=("$entry")
done < <(unzip -Z1 "$archive_file")
if (( ${#entries[@]} != 2 )) || [[ ${entries[0]} != nested/metadata.json || ${entries[1]} != result.txt ]]; then
  printf 'unexpected native archive entries: %s\n' "${entries[*]}" >&2
  exit 1
fi
[[ $(unzip -p "$archive_file" result.txt) == upload-artifact ]]
[[ $(unzip -p "$archive_file" nested/metadata.json) == '{"proof":"native-buildkite-artifact"}' ]]

log="$(bk --no-pager api "/jobs/$job_id/log" | jq -r '.content // ""')"
readonly expected_output="UPLOAD_ARTIFACT_OUTPUTS={\"id\":\"$artifact_id\",\"digest\":\"$digest_hex\"}"
if ! grep -F -- "$expected_output" <<<"$log" >/dev/null; then
  echo "job log does not contain action outputs bound to the terminal manifest" >&2
  exit 1
fi

printf 'UPLOAD_ARTIFACT_OBSERVATION={"build":%s,"commit":"%s","job":"%s","name":"upload-artifact-proof","id":"%s","path":"%s","digest":"%s","size":%s,"file_count":2}\n' \
  "$build_number" "$commit" "$job_id" "$artifact_id" "$archive_path" "$artifact_digest" "$artifact_size"
