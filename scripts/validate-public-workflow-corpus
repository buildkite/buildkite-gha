#!/usr/bin/env bash
set -euo pipefail

root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
work="$(mktemp -d "${TMPDIR:-/tmp}/buildkite-gha-corpus.XXXXXXXX")"
trap 'rm -rf -- "$work"' EXIT

cd "$root"
mise exec -- go build -trimpath -o "$work/validate-public-workflow-corpus" ./scripts
"$work/validate-public-workflow-corpus"
