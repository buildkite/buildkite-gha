#!/usr/bin/env bash
set -euo pipefail

# Regenerates internal/action/integration/checkout_main_commits.go from the
# commits reachable from actions/checkout upstream main. Each commit is
# recorded with the nearest upstream release at or before it, or "unreleased"
# for commits that predate the first release. Requires network access.

output=internal/action/integration/checkout_main_commits.go
[[ -d internal/action/integration ]] || { echo 'run from the repository root' >&2; exit 2; }

tmp=$(mktemp -d)
trap 'rm -rf "$tmp"' EXIT

git clone --quiet --bare --filter=blob:none https://github.com/actions/checkout "$tmp/checkout.git"

{
  echo '// Code generated by scripts/generate-checkout-commits. DO NOT EDIT.'
  echo
  echo 'package integration'
  echo
  echo '// checkoutMainCommits snapshots the commits reachable from actions/checkout'
  echo '// upstream main, keyed by commit and labeled with the nearest upstream'
  echo '// release at or before each commit. The native adapter replaces every'
  echo '// admitted implementation with the same bounded exact-event-SHA checkout,'
  echo '// so the label is diagnostic evidence, not a behavior selector. Commits'
  echo '// pushed upstream after this snapshot require regeneration.'
  echo 'var checkoutMainCommits = map[string]string{'
  git -C "$tmp/checkout.git" rev-list main | sort | while read -r sha; do
    release=$(git -C "$tmp/checkout.git" describe --tags --abbrev=0 --match 'v[0-9]*.[0-9]*.[0-9]*' "$sha" 2>/dev/null || echo unreleased)
    printf '\t"%s": "%s",\n' "$sha" "$release"
  done
  echo '}'
} > "$output"

gofmt -w "$output"
echo "wrote $output ($(git -C "$tmp/checkout.git" rev-list --count main) commits)"
