#!/usr/bin/env bash
set -euo pipefail

usage() {
  echo 'usage: scripts/starter-workflows-corpus [--profile] [case ...]' >&2
}

sha256_digest() {
  if command -v sha256sum >/dev/null; then
    sha256sum "$@" | cut -d ' ' -f 1
  elif command -v shasum >/dev/null; then
    shasum -a 256 "$@" | cut -d ' ' -f 1
  else
    echo 'sha256sum or shasum is required' >&2
    return 127
  fi
}

profile=false
explicit_cases=false
case_ids=()
while (( $# > 0 )); do
  case "$1" in
    --profile) profile=true ;;
    --help|-h) usage; exit 0 ;;
    -*) usage; exit 2 ;;
    *) explicit_cases=true; case_ids+=("$1") ;;
  esac
  shift
done

root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
readonly root manifest="$root/testdata/starter-workflows/manifest.json"
work="$(mktemp -d "${TMPDIR:-/tmp}/buildkite-gha-starter-workflows.XXXXXXXX")"
trap 'rm -rf -- "$work"' EXIT

cd "$root"
jq -e '
  .schema == "buildkite-gha/starter-workflows-corpus/v1" and
  (.repository == "actions/starter-workflows") and
  (.commit | test("^[0-9a-f]{40}$")) and
  (.default_branch | test("^[A-Za-z0-9][A-Za-z0-9._/-]*$") and (contains("..") | not)) and
  (.cases | type == "array" and length > 0) and
  all(.cases[];
    (.id | test("^[a-z0-9]+(?:-[a-z0-9]+)*$")) and
    (.template | test("^ci/[A-Za-z0-9_.-]+\\.yml$")) and
    (.template_sha256 | test("^[0-9a-f]{64}$")) and
    ((has("disabled_reason") | not) or
      (.disabled_reason | type == "string" and length > 0))) and
  ([.cases[].id] | length == (unique | length))
' "$manifest" >/dev/null

if (( ${#case_ids[@]} == 0 )); then
  while IFS= read -r case_id; do
    case_ids+=("$case_id")
  done < <(jq -r '.cases[].id' "$manifest")
fi
for id in "${case_ids[@]}"; do
  jq -e --arg id "$id" 'any(.cases[]; .id == $id)' "$manifest" >/dev/null || {
    echo "unknown corpus case: $id" >&2
    exit 2
  }
done

CGO_ENABLED=0 mise exec -- go build -trimpath -buildvcs=false -o "$work/buildkite-gha" ./cmd/buildkite-gha
mode=compile
desired=compilable
validate_args=()
if $profile; then
  mode=profile
  desired=admitted
  validate_args=(--profile hosted)
fi
summary="$work/summary.md"
printf '<h2 class="h4 mb2">Starter workflow compatibility — %s</h2>\n<div class="border-top border-gray pt2"></div>\n\n' "$mode" > "$summary"
passed=0
blocked=0
disabled=0

clean_env() {
  env \
    -u HTTP_PROXY -u HTTPS_PROXY -u ALL_PROXY -u NO_PROXY \
    -u http_proxy -u https_proxy -u all_proxy -u no_proxy \
    -u CURL_CA_BUNDLE -u SSL_CERT_FILE -u SSL_CERT_DIR \
    -u GH_TOKEN -u GITHUB_TOKEN -u BUILDKITE_GHA_GITHUB_TOKEN \
    "$@"
}

make_event() {
  local repository=$1 commit=$2 branch=$3 destination=$4
  local owner=${repository%%/*} name=${repository#*/}
  jq -n \
    --arg owner "$owner" --arg name "$name" --arg sha "$commit" \
    --arg branch "$branch" '
    def clone_url: "https://github.com/" + $owner + "/" + $name + ".git";
    def repository: {
      owner: $owner,
      name: $name,
      clone_url: clone_url,
      default_branch: $branch
    };
    {
      provider: "github",
      event: "push",
      repository: repository,
      ref: ("refs/heads/" + $branch),
      sha: $sha,
      actor: "buildkite-gha-starter-corpus",
      payload: {ref: ("refs/heads/" + $branch)}
    }
  ' > "$destination"
}

expand_template() {
  local source=$1 branch=$2 destination=$3
  local default_branch_placeholder=\$default-branch
  local starter_placeholder_pattern="\\\$(default-branch|protected-branches|cron-daily|registry-url\\([^)]*\\))"
  grep -Fq "$default_branch_placeholder" "$source" || {
    echo "$source: expected \$default-branch starter placeholder" >&2
    return 1
  }
  jq -Rrsj --arg branch "$branch" 'gsub("\\$default-branch"; $branch)' \
    "$source" > "$destination"
  if grep -Eq "$starter_placeholder_pattern" "$destination"; then
    echo "$source: unsupported starter-workflow placeholder remains after expansion" >&2
    return 1
  fi
}

record_report() {
  local id=$1 status=$2 output=$3 result codes reason graph icon
  if result="$(jq -er '.result | select(type == "string")' "$output")"; then
    codes="$(jq -r '[.diagnostics[]?.code] | unique | join(", ")' "$output")"
    reason="$(jq -r '[.diagnostics[]?.message | split(". ")[0] | gsub("\\s+"; " ")] | unique | if length == 0 then "" elif length == 1 then .[0] else .[0] + " (+" + ((length - 1) | tostring) + " more)" end | if length > 180 then .[:177] + "..." else . end' "$output")"
    graph="$(jq -r 'if has("compile") then .compile else . end | "\(.logical_jobs // 0) jobs, \(.instances // 0) instances"' "$output")"
  else
    result=invalid-report
    codes=E_REPORT
    reason='report could not be read'
    graph='0 jobs, 0 instances'
  fi
  if [[ "$status" == 0 && "$result" == "$desired" ]]; then
    icon='✅'
    passed=$((passed + 1))
  else
    icon='❌'
    blocked=$((blocked + 1))
  fi
  echo "$icon $id: result=$result; $graph; diagnostics=${codes:-none}"
  if [[ "$icon" == '❌' ]]; then
    jq -r '.diagnostics[]? | "  \(.code): \(.message)"' "$output" >&2 || true
  fi
  if [[ -n "$codes" ]]; then
    printf -- "- %s \`%s\`: \`%s\` — %s: %s\n" "$icon" "$id" "$result" "$codes" "$reason" >> "$summary"
  else
    printf -- "- %s \`%s\`: \`%s\`\n" "$icon" "$id" "$result" >> "$summary"
  fi
}

repository="$(jq -r '.repository' "$manifest")"
commit="$(jq -r '.commit' "$manifest")"
branch="$(jq -r '.default_branch' "$manifest")"
event_path="$work/event.json"
make_event "$repository" "$commit" "$branch" "$event_path"

for id in "${case_ids[@]}"; do
  entry="$(jq -c --arg id "$id" '.cases[] | select(.id == $id)' "$manifest")"
  disabled_reason="$(jq -r '.disabled_reason // empty' <<<"$entry")"
  if ! $explicit_cases && [[ -n "$disabled_reason" ]]; then
    echo "⏭️ $id: disabled; $disabled_reason"
    printf -- "- ⏭️ \`%s\`: disabled — %s\n" "$id" "$disabled_reason" >> "$summary"
    disabled=$((disabled + 1))
    continue
  fi
  template="$(jq -r '.template' <<<"$entry")"
  template_sha256="$(jq -r '.template_sha256' <<<"$entry")"

  case_root="$work/cases/$id"
  workflow=".github/workflows/$id.yml"
  workflow_path="$case_root/$workflow"
  source_path="$work/sources/$template"
  mkdir -p "$(dirname "$workflow_path")"
  mkdir -p "$(dirname "$source_path")"
  clean_env curl -q --fail --silent --show-error --proto '=https' --tlsv1.2 \
    --max-time 30 --max-filesize 1048576 --output "$source_path" \
    "https://raw.githubusercontent.com/$repository/$commit/$template"
  actual_sha256="$(sha256_digest "$source_path")"
  [[ "$actual_sha256" == "$template_sha256" ]] || {
    echo "$id: template digest=$actual_sha256, want $template_sha256" >&2
    exit 1
  }
  expand_template "$source_path" "$branch" "$workflow_path"

  status=0
  report="$work/$id.$mode.json"
  (
    cd "$case_root"
    clean_env "$work/buildkite-gha" validate "${validate_args[@]}" --format json \
      --event-path "$event_path" "$workflow"
  ) > "$report" || status=$?
  record_report "$id" "$status" "$report"
done

printf '\n**%d passing; %d blocked; %d disabled.**\n' "$passed" "$blocked" "$disabled" >> "$summary"
cat "$summary"
if [[ "${BUILDKITE:-}" == true ]] && command -v buildkite-agent >/dev/null; then
  style=success
  (( blocked > 0 || disabled > 0 )) && style=warning
  buildkite-agent annotate --context "starter-workflows-corpus-$mode" --style "$style" < "$summary" || \
    echo 'warning: failed to publish Buildkite annotation' >&2
fi
if $profile; then
  echo 'CAVEAT: profile checks resolve actions but do not execute third-party code.'
fi
(( blocked == 0 ))
