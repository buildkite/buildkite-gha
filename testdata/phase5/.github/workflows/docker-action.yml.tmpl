name: Phase 5 Dockerfile action proof

on:
  push:

jobs:
  docker-action:
    runs-on: ubuntu-latest
    steps:
      - name: Prepare workspace mount observation
        shell: bash
        run: printf '%s\n' phase5-workspace > phase5-marker

      - name: Run exact public Dockerfile action
        id: docker
        uses: buildkite/buildkite-gha/testdata/actions/docker@__PHASE5_COMMIT__
        with:
          expected_file: phase5-marker

      - name: Verify Dockerfile action effects
        shell: bash
        env:
          CONTAINER_RESULT: ${{ steps.docker.outputs.container }}
        run: |
          test "$CONTAINER_RESULT" = ran
          test "$DOCKER_RUNTIME_SEEN" = true
          printf '%s\n' 'PHASE5_DOCKER_OBSERVATION={"container":"ran","environment":"propagated","workspace":"mounted"}'
