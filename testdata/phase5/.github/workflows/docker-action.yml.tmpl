name: Phase 5 Dockerfile action proof

on:
  push:

jobs:
  docker-action:
    runs-on: ubuntu-latest
    steps:
      - name: Run exact public Dockerfile action
        id: docker
        uses: actions/hello-world-docker-action@8bcd8e1af3c095561f1043123848fc8b2db0f189
        with:
          who-to-greet: Phase 5

      - name: Verify Dockerfile action effects
        shell: bash
        env:
          ACTION_TIME: ${{ steps.docker.outputs.time }}
        run: |
          test -n "$ACTION_TIME"
          printf '%s\n' 'PHASE5_DOCKER_OBSERVATION={"container":"ran","output":"propagated","source":"public-exact"}'
