{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["github>buildkite/renovate-config"],
  "automerge": true,
  "automergeType": "pr",
  "platformAutomerge": true,
  "packageRules": [
    {
      "description": "Require manual review for major updates",
      "matchUpdateTypes": ["major"],
      "automerge": false
    },
    {
      "description": "Preserve action versions in examples and compatibility fixtures",
      "matchManagers": ["github-actions"],
      "matchFileNames": [
        "testdata/**",
        ".github/workflows/example-*.{yml,yaml}",
        ".github/workflows/*oracle*.{yml,yaml}",
        ".github/workflows/*-proof.{yml,yaml}",
        ".github/workflows/composite-hash-files.{yml,yaml}",
        ".github/workflows/experimental-runner-user.{yml,yaml}",
        ".github/actions/oracle-*/**",
        ".github/actions/hash-files/**",
        ".github/actions/experimental-runner-user/**"
      ],
      "enabled": false
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": ["/^internal\\/cli\\/hosted\\.go$/"],
      "matchStrings": [
        "defaultNobleRunnerImage\\s+=\\s+\"buildkite\\.namespace-images\\.com/agent-base@(?<currentDigest>sha256:[a-f0-9]{64})\""
      ],
      "datasourceTemplate": "docker",
      "depNameTemplate": "buildkite/agent-base",
      "currentValueTemplate": "ubuntu-noble-hosted-toolchains",
      "versioningTemplate": "docker"
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["/^internal\\/cli\\/hosted\\.go$/"],
      "matchStrings": [
        "defaultJammyRunnerImage\\s+=\\s+\"buildkite\\.namespace-images\\.com/agent-base@(?<currentDigest>sha256:[a-f0-9]{64})\""
      ],
      "datasourceTemplate": "docker",
      "depNameTemplate": "buildkite/agent-base",
      "currentValueTemplate": "ubuntu-jammy-hosted-toolchains",
      "versioningTemplate": "docker"
    }
  ]
}
